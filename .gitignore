__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
*.egg-info/
dist/
build/
.pytest_cache/

# Local tooling scratch. Untracked already, but named explicitly so a
# directory-source plugin install does not sweep them in, and so they can
# never be committed by accident.
.superpowers/
.serena/
tests/.last-transcript.txt
tests/.last-visible.txt
tests/.transcripts/
tests/.tools-venv/
tests/.progress/
# complexipy writes this when run from the repo root. It self-ignores today —
# the same trick Spyglass uses — but relying on a tool to keep doing that is a
# thin reason for it to stay out of someone's commit.
.complexipy_cache/
.mypy_cache/
